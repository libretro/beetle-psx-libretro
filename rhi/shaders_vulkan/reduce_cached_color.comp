#version 450
precision highp int;
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, r32ui) uniform uimage2D uWords;

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(coord, imageSize(uWords))))
		return;
	/* The low sixteen bits are the PS1 word, including its mask bit.
	 * Upper bits retain enhanced color precision between GPU domains. */
	imageStore(uWords, coord, imageLoad(uWords, coord) & uvec4(0xffffu));
}
