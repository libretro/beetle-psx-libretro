#version 450
layout(local_size_x = 8, local_size_y = 8) in;

#include "hdr.h"

/* Tonemap-weighted ("Karis") MSAA resolve for the scaled framebuffer.
 *
 * Built for both framebuffer formats: rgba16f under -DHDR16, rgba8 otherwise.
 * The SDR path used to take vkCmdResolveImage instead, which averages in the
 * image's own encoding - the wrong domain, and not something the fixed-function
 * resolve can be asked to change.
 *
 * The fixed-function vkCmdResolveImage the SDR path uses does a plain linear
 * box average of the samples. Under HDR that reintroduces bright-edge
 * aliasing: a single very-bright sub-sample (an additive spark, a specular
 * glint, an over-white polygon edge) dominates the linear mean and, after the
 * PQ curve, still reads as a hard aliased edge - the coverage was averaged but
 * it does not look anti-aliased. Weighting each sample by 1/(1 + luma) before
 * averaging tames the hot outlier so the edge actually softens. This is
 * HDR-specific: in SDR the [0,1] clamp already bounds the outlier, so the SDR
 * path keeps the cheaper fixed-function resolve untouched.
 *
 * Samples are combined as light. Supersampling and multisampling estimate how
 * much light a pixel emits, so the transfer curve goes inside the mean;
 * averaging the encoded values is darker by Jensen's inequality, badly so at
 * edges, which is the only place multisampling does anything.
 *
 * The weight has to be taken against *linear* luminance, which is what the
 * 1/(1+L) form is defined for. The stored value is PSX-native and gamma
 * encoded, so weighting it directly gives a code-2.0 sample 1/3 instead of
 * 1/6.3 - roughly double the influence - and the hot outlier the shader
 * exists to tame survives at about half the intended suppression. The
 * transfer is therefore applied before the weight. Luma is taken in the
 * signal domain and the curve applied once to the scalar rather than per
 * channel: the weight only has to be monotone in brightness, and this is one
 * pow per sample instead of three. The exponent matches quad.frag's encode.
 *
 * Fully-covered pixels (all samples equal) resolve to exactly the input,
 * so only mixed-coverage edges are affected. Alpha is resolved with a plain
 * average to match the fixed-function behaviour for anything that later reads
 * it. */

layout(constant_id = 0) const int NUM_SAMPLES = 1;
/* Transfer curve used to combine samples - the average is taken in light. */
layout(constant_id = 7) const int RESOLVE_EOTF = 0;

#if defined(HDR16)
#define RESOLVE_STORE_FMT rgba16f
#else
#define RESOLVE_STORE_FMT rgba8
#endif

layout(set = 0, binding = 0, RESOLVE_STORE_FMT) uniform writeonly image2D uResolved;
layout(set = 0, binding = 1) uniform sampler2DMS uScaledMS;

/* Resolve only the [offset, offset+extent) region (the displayed rect); the
 * dispatch is sized to extent and the base is added per invocation so both the
 * full-framebuffer and partial-rect callers share one shader. */
layout(push_constant, std430) uniform Push
{
	ivec2 offset;
	ivec2 extent;
} reg;

void main()
{
	ivec2 local = ivec2(gl_GlobalInvocationID.xy);
	ivec2 coord = reg.offset + local;
	vec3  acc   = vec3(0.0);
	float wsum  = 0.0;
	float a     = 0.0;
	int   i;

	if (any(greaterThanEqual(local, reg.extent)))
		return;

	for (i = 0; i < NUM_SAMPLES; i++)
	{
		vec4  s    = texelFetch(uScaledMS, coord, i);
		vec3  lin  = sdr_to_linear(max(s.rgb, vec3(0.0)), RESOLVE_EOTF);
		float luma = dot(lin, vec3(0.2126, 0.7152, 0.0722));
#if defined(HDR16)
		/* Only the wide target can carry over-white samples, so only it has
		 * fireflies to suppress. In SDR the values are already bounded and
		 * the weight would just bias the box darker for nothing. */
		float w    = 1.0 / (1.0 + luma);
#else
		float w    = 1.0;
#endif
		acc  += lin * w;
		wsum += w;
		a    += s.a;
	}

	imageStore(uResolved, coord,
	           vec4(linear_to_sdr(acc / wsum, RESOLVE_EOTF), a / float(NUM_SAMPLES)));
}
